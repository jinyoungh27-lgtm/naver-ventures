---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-lead">
      <span class="eyebrow eyebrow--light">Get in touch</span>
      <h2 class="h2">Let's talk</h2>
      <div class="footer-actions">
        <a href={`mailto:${site.email}`} class="btn btn--primary">Contact</a>
        <a
          href={site.linkedin}
          class="btn btn--ghost btn--on-dark btn--icon"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
      </div>
    </div>

    {
      nav.length > 0 && (
        <div class="footer-cols">
          <nav class="footer-col" aria-label="Footer">
            <span class="footer-heading">Explore</span>
            {nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        </div>
      )
    }
  </div>

  <div class="wrap footer-bottom">
    <span>© {year} {site.name}. All rights reserved.</span>
    <Logo tone="light" size="18px" class="footer-mark" />
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #fff;
    padding-top: clamp(4rem, 8vw, 7rem);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 4rem;
  }
  .eyebrow--light::before {
    background: var(--green);
  }
  .footer-lead .h2 {
    margin-top: 1rem;
    max-width: 14ch;
  }
  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .btn--icon {
    padding: 0;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.8);
  }
  .btn--icon:hover {
    color: #fff;
  }
  .btn--icon svg {
    width: 30px;
    height: 30px;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2rem;
    align-content: start;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .footer-heading {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.4rem;
  }
  .footer-col a {
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.18s ease;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 2rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-mark {
    opacity: 0.4;
  }
  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
