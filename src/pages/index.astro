---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';

// Spotlight rotates through every portfolio company in a random order;
// the marquee scrolls the full set of logos.
const shuffled = [...portfolio].sort(() => Math.random() - 0.5);
const featured = shuffled;
const marqueeA = portfolio;
const marqueeB = [...portfolio].reverse();
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="display reveal">
        Backing the founders building <span class="accent">what comes next</span>
      </h1>
      <p class="lead reveal" data-delay="160ms">
        {site.description}
      </p>
      <div class="hero-actions reveal" data-delay="240ms">
        <a href="/about" class="btn btn--primary">About us</a>
        <a href="/portfolio" class="btn btn--ghost">Portfolio</a>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- SHOWCASE -->
  <section class="section showcase">
    <div class="wrap showcase-head reveal">
      <p class="eyebrow">Who we back</p>
      <h2 class="h2">The teams we're proud to stand behind</h2>
    </div>

    <!-- Rotating spotlight -->
    <div class="wrap">
      <div class="spotlight reveal" data-delay="80ms">
        <div class="spot-glow" aria-hidden="true"></div>
        {
          featured.map((c, i) => (
            <article class:list={['spot', { 'is-active': i === 0 }]} data-spot={i}>
              <a
                class="spot-badge"
                href={c.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${c.name}`}
              >
                <img src={c.logo} alt={`${c.name} logo`} decoding="async" />
              </a>
              <a class="spot-name" href={c.url} target="_blank" rel="noopener noreferrer">
                {c.name}
              </a>
              <p class="spot-desc">{c.description}</p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Infinite logo marquee -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...marqueeA, ...marqueeA].map((c) => (
          <a class="m-logo" href={c.url} target="_blank" rel="noopener noreferrer" tabindex="-1">
            <img src={c.logo} alt={`${c.name} logo`} decoding="async" />
          </a>
        ))}
      </div>
    </div>
    <div class="marquee marquee--rev" aria-hidden="true">
      <div class="marquee-track">
        {[...marqueeB, ...marqueeB].map((c) => (
          <a class="m-logo" href={c.url} target="_blank" rel="noopener noreferrer" tabindex="-1">
            <img src={c.logo} alt={`${c.name} logo`} decoding="async" />
          </a>
        ))}
      </div>
    </div>

    <div class="wrap">
      <a href="/portfolio" class="logos-link reveal">View full portfolio →</a>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section approach">
    <div class="wrap approach-grid">
      <div class="approach-inner">
        <p class="eyebrow reveal">Our approach</p>
        <h2 class="h2 reveal">Building what's next, together</h2>
        <div class="approach-text reveal" data-delay="120ms">
          <p>
            We back founders with more than capital — the technology,
            partnerships, and reach to help them scale globally.
            <a href="/about" class="inline-link">More about how we work →</a>
          </p>
        </div>
      </div>

      <div class="approach-visual reveal" data-delay="160ms" aria-hidden="true">
        <span class="orb-glow"></span>
        <svg class="globe" viewBox="0 0 320 320" fill="none">
          <defs>
            <radialGradient id="sphere" cx="38%" cy="32%" r="75%">
              <stop offset="0%" stop-color="#f3fbf7" stop-opacity="0.95" />
              <stop offset="55%" stop-color="#eef4f1" stop-opacity="0.5" />
              <stop offset="100%" stop-color="#dfe7e3" stop-opacity="0.25" />
            </radialGradient>
          </defs>
          <circle cx="160" cy="160" r="118" fill="url(#sphere)" />
          <g class="g-grid">
            <circle cx="160" cy="160" r="118" />
            <ellipse cx="160" cy="160" rx="118" ry="40" />
            <ellipse cx="160" cy="160" rx="118" ry="79" />
            <line x1="42" y1="160" x2="278" y2="160" />
            <ellipse cx="160" cy="160" rx="40" ry="118" />
            <ellipse cx="160" cy="160" rx="79" ry="118" />
            <line x1="160" y1="42" x2="160" y2="278" />
          </g>
          <circle class="g-dot" cx="108" cy="98" r="3.5" />
          <circle class="g-dot" cx="232" cy="138" r="3.5" />
          <circle class="g-dot" cx="196" cy="234" r="3.5" />
        </svg>
        <span class="orb-mark">
          <img src="/logos/naver-wordmark.svg" alt="NAVER" decoding="async" />
        </span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 10rem);
    background: var(--paper);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 980px;
  }
  .hero .display {
    font-size: clamp(1.9rem, 7.5vw, 5rem);
    text-wrap: balance;
    max-width: 16ch;
  }
  .hero .lead {
    margin-top: 1.6rem;
  }
  .accent {
    color: var(--green-dark);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.6rem;
  }
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 760px;
    max-height: 760px;
    background: radial-gradient(
      circle,
      rgba(3, 199, 90, 0.18),
      rgba(3, 199, 90, 0) 62%
    );
    z-index: 1;
    pointer-events: none;
  }

  /* Dynamic showcase */
  .showcase {
    background: var(--paper-dim);
    overflow: hidden;
  }
  .showcase-head {
    margin-bottom: 2.5rem;
  }
  .showcase-head .h2 {
    margin-top: 1rem;
  }

  .spotlight {
    position: relative;
    display: grid;
    min-height: 340px;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
    overflow: hidden;
  }
  .spot-glow {
    position: absolute;
    inset: auto -10% -40% auto;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(3, 199, 90, 0.28), transparent 60%);
    pointer-events: none;
  }
  .spot {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
    position: relative;
    z-index: 1;
  }
  .spot.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .spot-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: #fff;
    border-radius: 16px;
  }
  .spot-badge img {
    width: 46px;
    height: 46px;
    object-fit: contain;
    border-radius: 8px;
  }
  .spot-badge {
    transition: transform 0.2s ease;
  }
  .spot-badge:hover {
    transform: translateY(-2px);
  }
  .spot-name {
    align-self: flex-start;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .spot-desc {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: rgba(255, 255, 255, 0.85);
    max-width: 44ch;
  }
  .marquee {
    margin-top: 1rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 10%,
      #000 90%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 10%,
      #000 90%,
      transparent
    );
  }
  .marquee:first-of-type {
    margin-top: 2.5rem;
  }
  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee--rev .marquee-track {
    animation-direction: reverse;
    animation-duration: 50s;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .m-logo {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 76px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }
  .m-logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 8px;
  }
  .m-logo:hover {
    border-color: var(--green);
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }

  .logos-link {
    display: inline-block;
    margin-top: 2.5rem;
    font-weight: 700;
    color: var(--green-dark);
  }
  .logos-link:hover {
    text-decoration: underline;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .approach-inner {
    max-width: 620px;
  }
  .approach-inner .h2 {
    margin-top: 1rem;
  }
  .approach-text {
    margin-top: 1.6rem;
  }

  .approach-visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 380px;
    width: 100%;
    margin-inline: auto;
  }
  .orb-glow {
    position: absolute;
    width: 92%;
    height: 92%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(3, 199, 90, 0.38),
      rgba(3, 199, 90, 0.12) 45%,
      transparent 70%
    );
    filter: blur(34px);
  }
  .globe {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .g-grid > * {
    stroke: var(--ink);
    stroke-width: 0.8;
    opacity: 0.1;
  }
  .g-grid > circle:first-child {
    opacity: 0.18;
  }
  .g-dot {
    fill: var(--green);
    filter: drop-shadow(0 0 5px rgba(3, 199, 90, 0.7));
  }
  .orb-mark {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .orb-mark img {
    width: 116px;
    height: auto;
    filter: drop-shadow(0 2px 10px rgba(255, 255, 255, 0.6));
  }
  .approach-text p {
    color: var(--muted);
    font-size: 1.15rem;
  }
  .approach-text p + p {
    margin-top: 1.2rem;
  }
  .inline-link {
    color: var(--green-dark);
    font-weight: 700;
  }
  .inline-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
    .approach-visual {
      order: -1;
      max-width: 260px;
    }
  }
</style>

<script>
  // Auto-rotating portfolio spotlight (pauses on reduced motion).
  const spots = Array.from(document.querySelectorAll<HTMLElement>('.spot'));

  if (spots.length > 1) {
    let cur = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (n: number) => {
      cur = (n + spots.length) % spots.length;
      spots.forEach((s, i) => s.classList.toggle('is-active', i === cur));
    };
    if (!reduce) window.setInterval(() => show(cur + 1), 4200);
  }
</script>
