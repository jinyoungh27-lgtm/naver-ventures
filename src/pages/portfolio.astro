---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';
---

<Layout title="Portfolio" description={`The companies ${site.name} is proud to back`}>
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Portfolio</p>
      <h1 class="display reveal" data-delay="80ms">
        The companies we're<br />proud to back
      </h1>
      <p class="lead reveal" data-delay="160ms">
        A snapshot of the founders building the future with us
      </p>
    </div>
  </section>

  <section class="section portfolio-section">
    <div class="wrap">
      <div class="portfolio-grid">
        {
          portfolio.map((c, i) => (
            <a
              class="company reveal"
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${c.name}`}
              data-delay={`${(i % 3) * 70}ms`}
            >
              <span class="company-logo">
                <img src={c.logo} alt={`${c.name} logo`} loading="lazy" decoding="async" />
              </span>
              <span class="company-name">
                {c.name}
                <span class="company-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="company-desc">{c.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .page-hero .display {
    margin-top: 1rem;
  }
  .page-hero .lead {
    margin-top: 1.6rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .company {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    min-height: 200px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .company:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: var(--shadow);
  }
  .company-logo {
    display: flex;
    align-items: center;
    height: 44px;
    margin-bottom: 1.4rem;
  }
  .company-logo img {
    height: 40px;
    width: 40px;
    object-fit: contain;
    border-radius: 10px;
  }
  .company-name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .company-arrow {
    color: var(--muted);
    font-weight: 700;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .company:hover .company-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--green-dark);
  }
  .company-desc {
    color: var(--muted);
    margin-top: 0.6rem;
  }

  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
