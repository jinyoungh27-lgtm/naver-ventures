---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { team } from '../data/team';

// Build initials for the avatar placeholder when no photo is set.
const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .slice(0, 2)
    .join('');
---

<Layout title="Team" description={`Meet the team behind ${site.name}.`}>
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Our team</p>
      <h1 class="display reveal" data-delay="80ms">
        Investors and operators,<br />in your corner.
      </h1>
      <p class="lead reveal" data-delay="160ms">
        A team that has founded, scaled, and invested in companies across the
        globe. When you partner with us, you get all of us.
      </p>
    </div>
  </section>

  <section class="section team-section">
    <div class="wrap">
      <div class="team-grid">
        {
          team.map((m, i) => (
            <article class="member reveal" data-delay={`${(i % 3) * 80}ms`}>
              <div class="member-photo">
                {m.photo ? (
                  <img src={m.photo} alt={m.name} loading="lazy" />
                ) : (
                  <span class="member-initials" aria-hidden="true">
                    {initials(m.name)}
                  </span>
                )}
              </div>
              <div class="member-body">
                <h3>{m.name}</h3>
                <span class="member-role">{m.role}</span>
                <p>{m.bio}</p>
                {m.linkedin && (
                  <a
                    class="member-link"
                    href={m.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section join">
    <div class="wrap join-inner reveal">
      <div>
        <p class="eyebrow">Join us</p>
        <h2 class="h2">We're always meeting exceptional people.</h2>
      </div>
      <a href={`mailto:${site.email}`} class="btn btn--primary">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .page-hero .display {
    margin-top: 1rem;
  }
  .page-hero .lead {
    margin-top: 1.6rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  .member {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .member:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: var(--shadow);
  }
  .member-photo {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #e9f9f0, #d3f3e1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member-initials {
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--green-dark);
    letter-spacing: -0.02em;
  }
  .member-body {
    padding: 1.6rem;
  }
  .member-body h3 {
    font-size: 1.3rem;
  }
  .member-role {
    display: block;
    color: var(--green-dark);
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0.3rem 0 0.9rem;
  }
  .member-body p {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .member-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    color: var(--ink);
  }
  .member-link:hover {
    color: var(--green-dark);
  }

  .join {
    background: var(--paper-dim);
  }
  .join-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .join-inner .h2 {
    margin-top: 1rem;
    max-width: 18ch;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
