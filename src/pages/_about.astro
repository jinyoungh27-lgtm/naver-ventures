---
import Layout from '../layouts/Layout.astro';
import { site, company, glance } from '../data/site';

const values = [
  {
    title: 'Founders first',
    body: 'We work for the people building the company. Our job is to remove obstacles, not add them.',
  },
  {
    title: 'Conviction over consensus',
    body: 'We make decisions quickly and back them fully, even when the thesis is not yet obvious.',
  },
  {
    title: 'Long-term partners',
    body: 'We invest in companies, not rounds. We are there from the first check to the public markets.',
  },
  {
    title: 'Global by default',
    body: "Through NAVER's platform we help founders cross borders into Asia and beyond from day one.",
  },
];

const timeline = [
  { year: '2014', text: 'NAVER Ventures founded to back ambitious founders at the earliest stages.' },
  { year: '2018', text: 'Expanded across APAC and led our first growth-stage rounds.' },
  { year: '2021', text: 'Crossed 50 active portfolio companies and opened a dedicated platform team.' },
  { year: '2024', text: 'Launched a focused AI and frontier-tech practice.' },
];
---

<Layout title="About" description={`About ${site.name} — our mission, values, and approach to early-stage investing.`}>
  <!-- INTRO -->
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">About us</p>
      <h1 class="display reveal" data-delay="80ms">
        The venture arm of<br />Korea's technology leader.
      </h1>
      <p class="lead reveal" data-delay="160ms">
        {company.intro}
      </p>
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section class="section glance-section">
    <div class="wrap">
      <div class="block-head reveal">
        <p class="eyebrow">NAVER at a glance</p>
        <h2 class="h2">The scale behind the platform.</h2>
      </div>
      <div class="glance-grid">
        {
          glance.stats.map((s, i) => (
            <div class="glance-stat reveal" data-delay={`${i * 60}ms`}>
              <span class="glance-value">{s.value}</span>
              <span class="glance-label">{s.label}</span>
            </div>
          ))
        }
      </div>
      <p class="glance-source reveal">{glance.source}</p>
    </div>
  </section>

  <!-- MISSION -->
  <section class="section mission">
    <div class="wrap mission-grid">
      <div class="reveal">
        <p class="eyebrow">Our mission</p>
      </div>
      <div class="mission-body reveal" data-delay="100ms">
        <p class="mission-statement">
          {company.partnership}
        </p>
        <p>
          Established to lead NAVER's global venture investment initiatives, we
          treat our founders' goals as our own — the right introduction, the
          next key hire, the path into new markets — and connect them to the
          reach of one of Asia's largest technology platforms.
        </p>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section values">
    <div class="wrap">
      <div class="block-head reveal">
        <p class="eyebrow">What we believe</p>
        <h2 class="h2">Four principles guide every decision.</h2>
      </div>
      <div class="values-grid">
        {
          values.map((v, i) => (
            <article class="value-card reveal" data-delay={`${i * 80}ms`}>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section timeline-section">
    <div class="wrap">
      <div class="block-head reveal">
        <p class="eyebrow">Our story</p>
        <h2 class="h2">A decade backing what comes next.</h2>
      </div>
      <ol class="timeline">
        {
          timeline.map((t, i) => (
            <li class="timeline-item reveal" data-delay={`${i * 80}ms`}>
              <span class="timeline-year">{t.year}</span>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .page-hero .display {
    margin-top: 1rem;
  }
  .page-hero .lead {
    margin-top: 1.6rem;
  }

  .glance-section {
    border-top: 1px solid var(--line);
  }
  .glance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.2rem) 2rem;
  }
  .glance-stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.4rem;
    border-top: 2px solid var(--green);
  }
  .glance-value {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .glance-label {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .glance-source {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .mission {
    background: var(--ink);
    color: #fff;
  }
  .mission .eyebrow {
    color: var(--green);
  }
  .mission .eyebrow::before {
    background: var(--green);
  }
  .mission-grid {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .mission-statement {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1.6rem;
  }
  .mission-body p:not(.mission-statement) {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
  }

  .block-head {
    max-width: 42ch;
    margin-bottom: 3rem;
  }
  .block-head .h2 {
    margin-top: 1rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }
  .value-card {
    padding: 2.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .value-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.7rem;
  }
  .value-card p {
    color: var(--muted);
  }

  .timeline-section {
    background: var(--paper-dim);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    padding: 1.8rem 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .timeline-item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .timeline-year {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--green-dark);
    letter-spacing: -0.02em;
  }
  .timeline-item p {
    font-size: 1.15rem;
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .mission-grid {
      grid-template-columns: 1fr;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
